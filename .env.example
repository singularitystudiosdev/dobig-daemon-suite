# Copy to .env.local (git-ignored) and fill in. Read by the dev/preview API server only;
# nothing here is ever sent to the browser.

# Gemini API key for Nano Banana 2.1 variants. Without it the demo serves the recorded sets
# (and says so). A key typed into the app is sent per request and never stored.
GEMINI_API_KEY=

# Optional. Override the Gemini endpoint (for tests against a mock). Default shown.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional. Where live results are cached (default .cache/variants). A cached file beats a recorded
# set, so point tests somewhere disposable.
# DAEMON_CACHE_DIR=
