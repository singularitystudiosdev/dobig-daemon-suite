# Copy to .env.local (git-ignored) and fill in. Read by the dev/preview API server only;
# nothing here is ever sent to the browser.

# Gemini API key for Nano Banana 2.1 variants. Without it nothing is generated
# (the app says so). A key typed into the app is sent per request and never stored.
GEMINI_API_KEY=

# Optional. Override the Gemini endpoint (for tests against a mock). Default shown.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional. Where generated images are written for the browser to load (default .cache/variants).
# Test runs should point it at a temp dir (DAEMON_CACHE_DIR=$(mktemp -d)).
# DAEMON_CACHE_DIR=
